SELECT object_id,cntr,tileid,segmentation_map_id,ra,dec,parent_id,vis_det,flag_vis,ellipticity,kron_radius,fwhm,flux_vis_2fwhm_aper,fluxerr_vis_2fwhm_aper,det_quality_flag,flag_y,flag_j,flag_h,flux_y_templfit,fluxerr_y_templfit,flux_j_templfit,fluxerr_j_templfit,flux_h_templfit,fluxerr_h_templfit,flux_y_2fwhm_aper,fluxerr_y_2fwhm_aper,flux_j_2fwhm_aper,fluxerr_j_2fwhm_aper,flux_h_2fwhm_aper,fluxerr_h_2fwhm_aper FROM euclid_dr1_mer_catalogue_deep_survey WHERE 1=CONTAINS(POINT('ICRS',ra,dec),CIRCLE('ICRS',52.933,-28.0885,0.125)) AND flux_j_templfit >= 0.91201083935591 AND flux_j_templfit < 2.2908676527678 ORDER BY cntr
